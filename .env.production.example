# ==============================================================================
# MEDINEX PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# Supply actual values ONLY via hosting provider secret stores (Railway / Render /
# Neon / Vercel). NEVER commit real production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Vercel Project Environment Variables)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="MediNex"
NEXT_PUBLIC_APP_TAGLINE="Connecting Technology, Research & Healthcare Innovation."
NEXT_PUBLIC_APP_URL="https://medinex-bd.vercel.app"
# Must be an HTTPS backend URL (no localhost allowed in production)
NEXT_PUBLIC_API_BASE_URL="https://YOUR-HOSTED-BACKEND-DOMAIN/api/v1"

# ------------------------------------------------------------------------------
# Backend Runtime (Managed Spring Boot PaaS)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
# Cloud PaaS (Render / Railway / Koyeb) injects PORT dynamically; SERVER_PORT is fallback
SERVER_PORT=8080
# Omit MANAGEMENT_SERVER_PORT on single-port PaaS so /actuator/health shares PORT
# MANAGEMENT_SERVER_PORT=8081

# ------------------------------------------------------------------------------
# Managed PostgreSQL (Neon Serverless / Render / Railway Postgres)
# ------------------------------------------------------------------------------
# Pooled TLS endpoint (-pooler on Neon) for Spring Data JPA runtime
SPRING_DATASOURCE_URL="jdbc:postgresql://YOUR-POOLED-DB-HOST:5432/neondb?sslmode=require"
SPRING_DATASOURCE_USERNAME="YOUR_DB_USER"
SPRING_DATASOURCE_PASSWORD="CHANGE_ME_STRONG_DB_PASSWORD"
# Direct non-pooled TLS endpoint (without -pooler on Neon) for Flyway migrations
SPRING_FLYWAY_URL="jdbc:postgresql://YOUR-DIRECT-DB-HOST:5432/neondb?sslmode=require"
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
DB_POOL_MAX=10
DB_POOL_MIN=2

# ------------------------------------------------------------------------------
# Security, CORS & JWT Secrets
# Generate key: openssl rand -base64 64
# ------------------------------------------------------------------------------
JWT_SECRET_KEY="CHANGE_ME_MINIMUM_256_BIT_RANDOM_SECRET"
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS="https://medinex-bd.vercel.app"
SPRINGDOC_ENABLED=false

# ------------------------------------------------------------------------------
# Media Storage (Mount persistent disk/volume at /app/uploads on backend container)
# ------------------------------------------------------------------------------
UPLOAD_DIR="/app/uploads"

# ------------------------------------------------------------------------------
# SMTP Email Delivery (Use verified domain SMTP provider; leave password blank only in non-prod)
# ------------------------------------------------------------------------------
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USERNAME="YOUR_SMTP_USERNAME"
MAIL_PASSWORD="CHANGE_ME_SMTP_APP_PASSWORD"
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM_ADDRESS="noreply@YOUR-DOMAIN"
MAIL_FROM_NAME="MediNex Platform"

# ------------------------------------------------------------------------------
# Initial Production Bootstrap Seeding
# In prod profile, demo contributor placeholders (contributor-01..06) are disabled.
# Set an explicit strong SEED_ADMIN_PASSWORD if initializing first Super Admin.
# ------------------------------------------------------------------------------
MEDINEX_SEED_ENABLED=true
SEED_ADMIN_EMAIL="admin@medinex.health"
SEED_ADMIN_PASSWORD=""
