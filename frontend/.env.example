# ==============================================================================
# MEDINEX FRONTEND ENVIRONMENT TEMPLATE (frontend/.env.example)
# Copy to frontend/.env.local for local Next.js runs, or configure in Vercel.
# ==============================================================================

NEXT_PUBLIC_APP_NAME="MediNex"
NEXT_PUBLIC_APP_TAGLINE="Connecting Technology, Research & Healthcare Innovation."

# Local Development Example:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8080/api/v1"

# Production (Vercel) Required Override:
# NEXT_PUBLIC_APP_URL="https://medinex-bd.vercel.app"
# NEXT_PUBLIC_API_BASE_URL="https://YOUR-HOSTED-BACKEND-DOMAIN/api/v1"
