# ==============================================================================
# MEDINEX ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env for local development. Never commit .env to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Frontend Configuration
FRONTEND_PORT=3002
NEXT_PUBLIC_APP_NAME="MediNex"
NEXT_PUBLIC_APP_TAGLINE="Healthcare Innovation. Connected Communities."
NEXT_PUBLIC_APP_URL="http://localhost:3002"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8082/api/v1"

# Backend / Spring Boot Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8082
SERVER_SERVLET_CONTEXT_PATH=/
MANAGEMENT_SERVER_PORT=8083

# PostgreSQL Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5434
POSTGRES_DB=medinex_db
POSTGRES_USER=medinex_user
POSTGRES_PASSWORD=medinex_secure_password_dev_only
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/medinex_db
SPRING_DATASOURCE_USERNAME=medinex_user
SPRING_DATASOURCE_PASSWORD=medinex_secure_password_dev_only

# Flyway Migrations
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# Security & JWT Token Secrets (Use strong random strings in production: openssl rand -base64 64)
JWT_SECRET_KEY=4c56e297893a778c187e1451b5c2a13b4f59837651a2d48698ecb819f3900cb93ad9871f92e071e6d1f054817a1936c5
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# CORS Configuration (Comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002,http://frontend:3000

# Redis Cache (Optional / Dev profile)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration (Google Apps Script / Brevo HTTPS for PaaS; Gmail SMTP for local dev)
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=
BREVO_API_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=medinexbd.noreply@gmail.com
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM_ADDRESS=medinexbd.noreply@gmail.com
MAIL_FROM_NAME="MediNex Platform"

# Local S3-compatible Object Storage (MinIO) (Optional profile)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=medinex-media
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1

# Super Admin Seed Account (Used ONLY for initial database seeding if no admin exists)
SEED_ADMIN_EMAIL=admin@medinex.health
SEED_ADMIN_PASSWORD=Admin@SecurePass2026!
SEED_ADMIN_NAME="MediNex Lead Administrator"
